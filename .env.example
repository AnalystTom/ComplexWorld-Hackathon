OPENAI_API_KEY=sk-...               # GPT-5.4 Searcher

# --- Deceiver Phase A (build_tasks.py) ---
GEMINI_API_KEY=...                  # Google AI Studio key for Gemini 3 Flash

# --- Publish (orwd CLI) ---
OPENREWARD_API_KEY=...              # from openreward.ai/settings
