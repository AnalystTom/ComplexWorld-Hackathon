# Copy to .env and fill in. Loaded automatically by build_tasks.py and
# agents/run.py. .env is gitignored — never commit.
#
# The harness routes Haiku 4.5 and Gemini 3 Flash through OpenRouter (one
# key) and GPT-5.4 through OpenAI directly. If you have native Anthropic
# and Google AI Studio keys instead, see "Alternates" below.

# --- Primary: OpenRouter for Haiku Searcher + Gemini Deceiver ---
OPENROUTER_API_KEY=sk-or-v1-...

# --- Primary: OpenAI direct for GPT-5.4 Searcher ---
OPENAI_API_KEY=sk-...

# --- Publish to OpenReward (orwd CLI) ---
OPENREWARD_API_KEY=...

# --- Alternates (only if NOT using OpenRouter) ---
# ANTHROPIC_API_KEY=sk-ant-...   # Native Anthropic SDK path (currently unused;
#                                #  Haiku Searcher goes via OpenRouter)
# GEMINI_API_KEY=...             # Native google-genai SDK; build_tasks.py
#                                #  picks this up only if OPENROUTER_API_KEY
#                                #  is unset.

# --- Optional model id overrides ---
# HAIKU_MODEL_ID=anthropic/claude-haiku-4.5
# GPT_MODEL_ID=gpt-5.4
# DECEIVER_MODEL=google/gemini-3-flash    # OpenRouter id when using OpenRouter
# DECEIVER_TEMPERATURE=0.7
